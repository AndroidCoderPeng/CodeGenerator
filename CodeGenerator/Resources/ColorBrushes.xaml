<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  背景  -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FFFFFF" />

    <!--  边框  -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E5EC" />
    <SolidColorBrush x:Key="CardBorderHighlightBrush" Color="#D7DBE3" />

    <!--  文字  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111A2E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6480" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#98A1B8" />

    <!--  指标卡 / 徽标底色  -->
    <SolidColorBrush x:Key="IconBadgeBlueBrush" Color="#E6EEFF" />
    <SolidColorBrush x:Key="IconBadgeTealBrush" Color="#E2F9F4" />
    <SolidColorBrush x:Key="IconBadgePurpleBrush" Color="#F0E9FF" />
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#E6EEFF" />

    <!--  滚动条  -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D7DBE3" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#98A1B8" />

    <Color x:Key="AccentBlueColor">#5B8CFF</Color>

    <!--  焦点光晕  -->
    <SolidColorBrush x:Key="FocusGlowBrush" Color="{StaticResource AccentBlueColor}" />

    <!--  强调色  -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9B6BFF" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="#3FD9B4" />

    <!--  主按钮 / Logo 渐变（135 度）：蓝 → 紫  -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B8CFF" />
        <GradientStop Offset="1" Color="#9B6BFF" />
    </LinearGradientBrush>

    <!--  进度条渐变（横向）：蓝 → 紫 → 青  -->
    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#5B8CFF" />
        <GradientStop Offset="0.6" Color="#9B6BFF" />
        <GradientStop Offset="1" Color="#3FD9B4" />
    </LinearGradientBrush>

    <!--  必填标记 / 警告  -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5F57" />

    <!--  按钮文字（渐变底上恒为白色）  -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
