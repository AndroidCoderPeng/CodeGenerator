<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LightBgLevel0Color}" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource LightBgLevel1Color}" />

    <!-- 面板与卡片 -->
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource LightPanelColor}" />
    <SolidColorBrush x:Key="PanelStrongBrush" Color="{StaticResource LightPanelStrongColor}" />

    <!-- 描边与分隔线 -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LightBorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource LightBorderStrongColor}" />

    <!-- 输入框底与悬停底 -->
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource LightFieldColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource LightHoverColor}" />

    <!-- 文本三级 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource LightTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource LightTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource LightTextTertiaryColor}" />

    <!-- 浅色下投影更淡 -->
    <Color x:Key="GlowColor">#2A5B8CFF</Color>

</ResourceDictionary>