<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DarkBgLevel0Color}" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource DarkBgLevel1Color}" />

    <!-- 面板与卡片 -->
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource DarkPanelColor}" />
    <SolidColorBrush x:Key="PanelStrongBrush" Color="{StaticResource DarkPanelStrongColor}" />

    <!-- 描边与分隔线 -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource DarkBorderStrongColor}" />

    <!-- 输入框底与悬停底 -->
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource DarkFieldColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource DarkHoverColor}" />

    <!-- 文本三级 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource DarkTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource DarkTextTertiaryColor}" />

    <!-- 按钮投影色 -->
    <Color x:Key="GlowColor">#595B8CFF</Color>

</ResourceDictionary>