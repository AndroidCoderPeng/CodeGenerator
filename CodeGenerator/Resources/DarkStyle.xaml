<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <StaticResource x:Key="BackgroundBrush" ResourceKey="DarkBgLevel0Brush" />
    <StaticResource x:Key="WindowBrush" ResourceKey="DarkBgLevel1Brush" />

    <!-- 面板 / 卡片（玻璃拟态层） -->
    <StaticResource x:Key="PanelBrush" ResourceKey="DarkPanelBrush" />
    <StaticResource x:Key="PanelStrongBrush" ResourceKey="DarkPanelStrongBrush" />

    <!-- 描边 / 分隔线 -->
    <StaticResource x:Key="BorderBrush" ResourceKey="DarkBorderBrush" />
    <StaticResource x:Key="BorderStrongBrush" ResourceKey="DarkBorderStrongBrush" />

    <!-- 输入框底 / 悬停底 -->
    <StaticResource x:Key="FieldBrush" ResourceKey="DarkFieldBrush" />
    <StaticResource x:Key="HoverBrush" ResourceKey="DarkHoverBrush" />

    <!-- 文本三级 -->
    <StaticResource x:Key="TextPrimaryBrush" ResourceKey="DarkTextPrimaryBrush" />
    <StaticResource x:Key="TextSecondaryBrush" ResourceKey="DarkTextSecondaryBrush" />
    <StaticResource x:Key="TextTertiaryBrush" ResourceKey="DarkTextTertiaryBrush" />

    <!-- 按钮投影色 -->
    <Color x:Key="GlowColor">#595B8CFF</Color>

</ResourceDictionary>