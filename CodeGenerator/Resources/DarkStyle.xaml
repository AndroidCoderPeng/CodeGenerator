<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        暗色主题资源。Key 与 LightStyle.xaml 一一对应，
        运行时替换 App.xaml 合并字典中的 DarkStyle/LightStyle 即可切换主题。
        颜色来源：design/index.html 的 html[data-theme="dark"] 变量及等效换算。
    -->

    <!--  背景  -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1322" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#131926" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#1A202F" />

    <!--  边框  -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#242836" />
    <SolidColorBrush x:Key="CardBorderHighlightBrush" Color="#303441" />

    <!--  文字  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA6C4" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66708C" />

    <!--  指标卡 / 徽标底色  -->
    <SolidColorBrush x:Key="IconBadgeBlueBrush" Color="#232E4C" />
    <SolidColorBrush x:Key="IconBadgeTealBrush" Color="#203A40" />
    <SolidColorBrush x:Key="IconBadgePurpleBrush" Color="#26244E" />
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#232E4C" />

    <!--  滚动条  -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#303441" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#66708C" />

    <!--  焦点光晕  -->
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#5B8CFF" />
</ResourceDictionary>
