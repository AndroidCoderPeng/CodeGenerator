<Application
    x:Class="CodeGenerator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  强调色、渐变、交通灯等共享画刷  -->
                <ResourceDictionary Source="Resources/ColorBrushes.xaml" />

                <!--  固定使用亮色样式  -->
                <ResourceDictionary Source="Resources/LightStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>