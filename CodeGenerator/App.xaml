<Application
    x:Class="CodeGenerator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  主题无关资源：强调色、渐变、交通灯等  -->
                <ResourceDictionary Source="Resources/ColorBrushes.xaml" />

                <!--  主题资源：暗色（切换亮色时替换为 Resources/LightStyle.xaml）  -->
                <ResourceDictionary Source="Resources/DarkStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>