<Window
    x:Class="CodeGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CodeGenerator.ViewModels"
    Title="软著代码生成器"
    Width="1080"
    Height="756"
    MinWidth="1080"
    MinHeight="756"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{StaticResource WindowBackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource FocusGlowBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 输入框（带水印） ==========  -->
        <Style x:Key="PlaceholderFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource FocusGlowBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Grid Margin="10,0">
                                <TextBlock
                                    x:Name="PlaceholderText"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    IsHitTestVisible="False"
                                    Text="{TemplateBinding Tag}"
                                    Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  空文本 -> 显示水印；同时覆盖 null，绑定为 null 时 Value="" 是不匹配的  -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CodeFolderTextBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Opacity="0.18"
                                                ShadowDepth="0"
                                                Color="{StaticResource AccentBlueColor}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  图标  -->
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                            FontSize="18"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="&#xe680;" />

                        <!--  输入框 + placeholder  -->
                        <Grid Grid.Column="1">
                            <TextBox
                                x:Name="CodeFolderTextBox"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding CodeFolder, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                IsHitTestVisible="False"
                                Text="选择源码文件夹，如：D:\Pengxh\Code\CodeGenerator\CodeGenerator">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CodeFolderTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Grid.Column="1"
                    Margin="16,0"
                    Command="{Binding SelectCodeFolderCommand}"
                    Style="{StaticResource PrimaryCompactButtonStyle}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                FontSize="16"
                                Text="&#xe680;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="选择文件夹" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{Binding ReTraverseFolderCommand}"
                    Content="&#xe614;"
                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                    FontSize="20"
                    Style="{StaticResource CompactButtonStyle}" />
            </Grid>

            <Border
                Grid.Row="1"
                Margin="16,0,16,16"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="12,0"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource IconBadgeBlueBrush}"
                        BorderThickness="0"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                FontSize="16"
                                Foreground="{StaticResource AccentBlueBrush}"
                                Text="&#xe69e;" />

                            <TextBlock
                                Margin="12,8,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBlueBrush}"
                                Text="遍历范围" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock Margin="12,8" FontSize="14">
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="白名单" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding WhiteListSuffix.Count, Mode=OneWay}" />
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="类后缀" />
                        </TextBlock>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock Margin="12,8" FontSize="14">
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="排除" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding BlackListConfig.Folders.Count, Mode=OneWay, FallbackValue=34}" />
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="类目录" />
                        </TextBlock>
                    </Border>

                    <Border
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock Margin="12,8" FontSize="14">
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="排除" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding BlackListConfig.Files.Count, Mode=OneWay, FallbackValue=6}" />
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="类文件" />
                        </TextBlock>
                    </Border>

                    <Border
                        Grid.Column="4"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock Margin="12,8" FontSize="14">
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="单文件 &lt;=" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding BlackListConfig.FileSizeLimit, FallbackValue=2}" />
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="MB" />
                        </TextBlock>
                    </Border>

                    <Border
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock Margin="12,8" FontSize="14">
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="文件数上限" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding BlackListConfig.MaxFileCount, Mode=OneWay, FallbackValue=5000}" />
                            <Run Foreground="{StaticResource TextSecondaryBrush}" Text="个" />
                        </TextBlock>
                    </Border>

                    <Button
                        Grid.Column="6"
                        Margin="12,8"
                        HorizontalAlignment="Right"
                        Command="{Binding EditTraverseRuleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Padding" Value="14,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="ButtonContainerBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Text="&#xe716;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="编辑规则" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="376" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="16,0,0,16"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.5" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="源码文件" />

                            <Border
                                Grid.Column="1"
                                Margin="16,0"
                                Background="{StaticResource IconBadgeBlueBrush}"
                                CornerRadius="12">
                                <TextBlock
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBlueBrush}"
                                    Text="{Binding SelectedFiles.Count, Mode=OneWay, StringFormat={}{0} 个, FallbackValue=0 个}" />
                            </Border>

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="双击打开 · 悬停移除" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,0,0,1" />

                        <Grid Grid.Row="2" Margin="4">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding SelectedFiles}"
                                ScrollViewer.CanContentScroll="False"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="CardBorder"
                                            Width="152"
                                            Height="128"
                                            Margin="4"
                                            Background="White"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            ToolTip="{Binding FileName}">
                                            <Grid>
                                                <StackPanel
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                                            FontSize="56"
                                                            Foreground="{Binding FileTypeColor, FallbackValue={StaticResource TextSecondaryBrush}}"
                                                            Text="&#xe652;" />

                                                        <TextBlock
                                                            Margin="0,12,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding FileTypeColor, FallbackValue={StaticResource TextSecondaryBrush}}"
                                                            Text="{Binding FileSuffix, FallbackValue=Java}" />
                                                    </Grid>

                                                    <TextBlock
                                                        Margin="0,8"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{Binding FileName}" />

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource TextTertiaryBrush}"
                                                        Text="{Binding FileSize}" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="RemoveCodeFileButton"
                                                    Command="{Binding DataContext.RemoveCodeFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="Collapsed">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Width" Value="24" />
                                                            <Setter Property="Height" Value="24" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Content" Value="&#xe668;" />
                                                            <Setter Property="FontFamily" Value="/CodeGenerator;component/IconFont/#iconfont" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                            <Setter Property="Padding" Value="4" />
                                                            <Setter Property="Margin" Value="4" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            x:Name="MiniButtonBorder"
                                                                            Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="12"
                                                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>

                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}" />
                                                <Setter TargetName="RemoveCodeFileButton" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="MouseDoubleClick">
                                        <b:InvokeCommandAction Command="{Binding OpenCodeFileCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ListBox>

                            <!--  空态：无文件时覆盖显示  -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Rectangle
                                    RadiusX="8"
                                    RadiusY="8"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeDashArray="3 3" />

                                <StackPanel VerticalAlignment="Center">
                                    <Border
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="24">
                                        <TextBlock
                                            Margin="24"
                                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                            FontSize="48"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Text="&#xe680;" />
                                    </Border>

                                    <TextBlock
                                        Margin="0,16"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="这里什么都没有~" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="先选择一个源码文件夹吧" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="16,0,16,16"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton
                                                            Command="ScrollBar.PageUpCommand"
                                                            Focusable="False"
                                                            Opacity="0" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Focusable="False">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border
                                                                        x:Name="ThumbBorder"
                                                                        Margin="2"
                                                                        Background="{StaticResource ScrollBarThumbBrush}"
                                                                        CornerRadius="6" />
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton
                                                            Command="ScrollBar.PageDownCommand"
                                                            Focusable="False"
                                                            Opacity="0" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Margin="12" Orientation="Horizontal">
                                <Border
                                    Margin="0,2"
                                    BorderBrush="{StaticResource AccentGradientBrush}"
                                    BorderThickness="3"
                                    CornerRadius="1.5" />

                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="文档设置" />
                            </StackPanel>

                            <TextBlock
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="必填信息" />

                            <StackPanel
                                Margin="12,16,12,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource DangerBrush}"
                                    Text="*" />

                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="页眉" />
                            </StackPanel>

                            <TextBox
                                Margin="12,0"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding DocumentHeader}" />

                            <StackPanel
                                Margin="12,12,12,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource DangerBrush}"
                                    Text="*" />

                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="软件版本号" />
                            </StackPanel>

                            <TextBox
                                Margin="12,0"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding SoftwareVersion, FallbackValue=V1.0.0}" />

                            <TextBlock
                                Margin="12"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="排版参数" />

                            <UniformGrid Columns="2" Rows="1">
                                <StackPanel Margin="12,0" Orientation="Vertical">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="代码页数" />

                                    <TextBox
                                        Margin="0,4,0,0"
                                        Style="{StaticResource FieldTextBoxStyle}"
                                        Text="{Binding DocumentPage, FallbackValue=60}" />
                                </StackPanel>

                                <StackPanel Margin="12,0" Orientation="Vertical">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="文档字号" />

                                    <TextBox
                                        Margin="0,4,0,0"
                                        Style="{StaticResource FieldTextBoxStyle}"
                                        Text="{Binding DocFontSize, FallbackValue=8}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock
                                Margin="12,12,12,4"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="源码文件后缀" />

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Style="{StaticResource PlaceholderFieldTextBoxStyle}"
                                    Tag="如：cs" />

                                <Button
                                    Grid.Column="1"
                                    Height="36"
                                    Margin="12,0,0,0"
                                    Padding="10,0"
                                    Command="{Binding AddFileSuffixTypeCommand}"
                                    Content="&#xe605;"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Style="{StaticResource PrimaryCompactButtonStyle}" />
                            </Grid>

                            <ListBox
                                Margin="12"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding FileSuffixTypes}"
                                ScrollViewer.CanContentScroll="False" />

                            <TextBlock
                                Margin="12,0"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="常用语言" />

                            <ListBox
                                Margin="12,4"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding DefaultFileSuffixTypes}"
                                ScrollViewer.CanContentScroll="False"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border
                                                                    x:Name="CardBorder"
                                                                    Padding="16,8"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="16">
                                                                    <ContentPresenter />
                                                                </Border>

                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="Transparent" />
                                                                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="16,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding CurrentFile, StringFormat={}正在读取：{0}, FallbackValue=正在读取：}" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentTealBrush}"
                            Text="{Binding CurrentProgress, FallbackValue=0%}" />
                    </Grid>

                    <ProgressBar
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource ProgressGradientBrush}"
                        Value="{Binding CurrentProgress}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Height" Value="12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border
                                                    x:Name="PART_Track"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" />
                                                <Border
                                                    x:Name="PART_Indicator"
                                                    Margin="2"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="4" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>

                <Button
                    Grid.Column="1"
                    Margin="16,0"
                    Command="{Binding GeneratorCodeCommand}"
                    Style="{StaticResource PrimaryCompactButtonStyle}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                FontSize="16"
                                Text="&#xe60c;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="生成文档" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{Binding SaveDocumentCommand}"
                    Content="&#xe6ca;"
                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                    FontSize="20"
                    Style="{StaticResource CompactButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>