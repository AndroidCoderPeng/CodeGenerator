<Window
    x:Class="CodeGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:CodeGenerator.ViewModels"
    Title="软著代码生成器"
    Width="1366"
    Height="768"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{StaticResource WindowBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Dot"
                                Width="14"
                                Height="14"
                                Background="{StaticResource TrafficRedBrush}"
                                CornerRadius="7" />
                            <ContentPresenter
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Dot"
                                Width="14"
                                Height="14"
                                Background="{StaticResource TrafficYellowBrush}"
                                CornerRadius="7" />
                            <ContentPresenter
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Dot"
                                Width="14"
                                Height="14"
                                Background="{StaticResource TrafficGreenBrush}"
                                CornerRadius="7" />
                            <ContentPresenter
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            「选择文件夹」主按钮
            对应视觉稿 .btn-solid：46px 高、12px 圆角、蓝紫 135° 渐变、蓝色柔光投影；
            悬停上移 2px 且投影加深，按下复位，禁用时整体半透明。
        -->
        <Style x:Key="SelectFolderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <!--  自定义 Template 后关掉系统焦点虚线，改由背景变化表达焦点  -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    x:Name="Shadow"
                                    BlurRadius="22"
                                    Direction="90"
                                    Opacity="0.35"
                                    ShadowDepth="8"
                                    Color="#5B8CFF" />
                            </Border.Effect>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  悬停：投影 28/12、透明度 .5，与视觉稿 hover 态一致  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shadow" Property="BlurRadius" Value="28" />
                                <Setter TargetName="Shadow" Property="ShadowDepth" Value="12" />
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!--  按下：回到原位  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭">
                        <Path
                            Width="8"
                            Height="8"
                            Data="M0.9,0.9 L5.1,5.1 M5.1,0.9 L0.9,5.1"
                            Stretch="Uniform"
                            Stroke="{StaticResource TrafficGlyphRedBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                    </Button>

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimizeClick"
                        Style="{StaticResource MinButtonStyle}"
                        ToolTip="最小化">
                        <Path
                            Width="8"
                            Height="8"
                            Data="M0.8,3 H5.2"
                            Stretch="Uniform"
                            Stroke="{StaticResource TrafficGlyphYellowBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                    </Button>

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnZoomClick"
                        Style="{StaticResource ZoomButtonStyle}"
                        ToolTip="最大化">
                        <Path
                            Width="8"
                            Height="8"
                            Data="M3,0.9 V5.1 M0.9,3 H5.1"
                            Stretch="Uniform"
                            Stroke="{StaticResource TrafficGlyphGreenBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  原窗口内容  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding CurrentFile, StringFormat={}正在读取：{0}}" />

                            <TextBlock Grid.Column="1" Text="{Binding CurrentProgress}" />
                        </Grid>

                        <ProgressBar Grid.Row="1" />
                    </Grid>

                    <Button Grid.Column="1" Margin="16,0">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="生成文档" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Grid.Column="2" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>