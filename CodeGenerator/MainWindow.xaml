<Window
    x:Class="CodeGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:CodeGenerator.ViewModels"
    Title="软著代码生成器"
    Width="1366"
    Height="768"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="#0E1322"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  主按钮 / Logo 渐变（135 度）  -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5B8CFF" />
            <GradientStop Offset="1" Color="#9B6BFF" />
        </LinearGradientBrush>

        <!--  进度条渐变：蓝 紫 青  -->
        <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#5B8CFF" />
            <GradientStop Offset="0.6" Color="#9B6BFF" />
            <GradientStop Offset="1" Color="#3FD9B4" />
        </LinearGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#FF5F57"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#FEBC2E"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#28C840"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#242836" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#9BA6C4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#5B8CFF" />
                                <Setter Property="Foreground" Value="#5B8CFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#131926"
            BorderBrush="#242836"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#9BA6C4"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭" />

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimizeClick"
                        Style="{StaticResource MinButtonStyle}"
                        ToolTip="最小化" />

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnZoomClick"
                        Style="{StaticResource ZoomButtonStyle}"
                        ToolTip="最大化" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  原窗口内容  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="48"
                        Background="Transparent"
                        BorderThickness="1.5"
                        CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#242836" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CodeFolderTextBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="#5B8CFF" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.18"
                                                    ShadowDepth="0"
                                                    Color="#5B8CFF" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  搜索图标  -->
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                FontSize="18"
                                Foreground="#9BA6C4"
                                Text="&#xe680;" />

                            <!--  输入框 + placeholder  -->
                            <Grid Grid.Column="1">
                                <TextBox
                                    x:Name="CodeFolderTextBox"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Foreground="#9BA6C4"
                                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#9BA6C4"
                                    IsHitTestVisible="False"
                                    Text="选择源码文件夹，如：D:\Pengxh\Code\CodeGenerator\CodeGenerator">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CodeFolderTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="16,0"
                        Command="{Binding SelctCodeFolderCommand}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Text="&#xe680;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="选择文件夹" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding ChangeThemeCommand}"
                        Content="&#xe71f;"
                        FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                        FontSize="20"
                        Style="{StaticResource CompactButtonStyle}" />
                </Grid>

                <UniformGrid
                    Grid.Row="1"
                    Margin="16,0"
                    Columns="3"
                    Rows="1">
                    <Border
                        BorderBrush="#242836"
                        BorderThickness="1.5"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="16"
                                Background="#232E4C"
                                CornerRadius="12">
                                <TextBlock
                                    Margin="12"
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="20"
                                    Foreground="#5B8CFF"
                                    Text="&#xe652;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Foreground="#9BA6C4" Text="已选源码文件" />

                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding SelectedFiles.Count, FallbackValue=0}" />

                                    <TextBlock
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="#9BA6C4"
                                        Text="个" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Margin="16,0"
                        BorderBrush="#242836"
                        BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="16"
                                Background="#203A40"
                                CornerRadius="12">
                                <TextBlock
                                    Margin="12"
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="20"
                                    Foreground="#3FD9B4"
                                    Text="&#xe71a;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Foreground="#9BA6C4" Text="有效代码" />

                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding EffectiveCodeLines.Length, FallbackValue=0}" />

                                    <TextBlock
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="#9BA6C4"
                                        Text="行" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#242836" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="16"
                                Background="#26244E"
                                CornerRadius="12">
                                <TextBlock
                                    Margin="12"
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="20"
                                    Foreground="#9B6BFF"
                                    Text="&#xe6f0;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Foreground="#9BA6C4" Text="预计生成" />

                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding ExpectedCodePages.Length, FallbackValue=0}" />

                                    <TextBlock
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="#9BA6C4"
                                        Text="页 · " />

                                    <TextBlock
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="#9BA6C4"
                                        Text="{Binding DocFontSize, StringFormat={}{0}号字, FallbackValue=8号字}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="#242836"
                BorderThickness="0,2,0,0">
                <Grid Margin="16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Foreground="#9BA6C4"
                                Text="{Binding CurrentFile, StringFormat={}正在读取：{0}, FallbackValue=正在读取：}" />

                            <TextBlock
                                Grid.Column="1"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#3FD9B4"
                                Text="{Binding CurrentProgress, FallbackValue=0%}" />
                        </Grid>

                        <ProgressBar
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1.5"
                            Foreground="{StaticResource ProgressGradientBrush}"
                            Value="{Binding CurrentProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border
                                                        x:Name="PART_Track"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" />
                                                    <Border
                                                        x:Name="PART_Indicator"
                                                        Margin="2"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="4" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>

                    <Button
                        Grid.Column="1"
                        Margin="16,0"
                        Command="{Binding GeneratorCodeCommand}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Text="&#xe60c;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="生成文档" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding SaveDocumentCommand}"
                        Content="&#xe6ca;"
                        FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                        FontSize="20"
                        Style="{StaticResource CompactButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>