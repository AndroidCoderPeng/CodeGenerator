<Window
    x:Class="CodeGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:CodeGenerator.ViewModels"
    Title="软著代码生成器"
    Width="1366"
    Height="768"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="#0E1322"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  主按钮 / Logo 渐变（135 度）  -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5B8CFF" />
            <GradientStop Offset="1" Color="#9B6BFF" />
        </LinearGradientBrush>

        <!--  进度条渐变：蓝 紫 青  -->
        <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#5B8CFF" />
            <GradientStop Offset="0.6" Color="#9B6BFF" />
            <GradientStop Offset="1" Color="#3FD9B4" />
        </LinearGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#FF5F57"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#FEBC2E"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Width="14"
                                Height="14"
                                Background="#28C840"
                                CornerRadius="7" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#242836" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#9BA6C4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#5B8CFF" />
                                <Setter Property="Foreground" Value="#5B8CFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#9BA6C4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#242836" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#5B8CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#131926"
            BorderBrush="#242836"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#9BA6C4"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭" />

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimizeClick"
                        Style="{StaticResource MinButtonStyle}"
                        ToolTip="最小化" />

                    <Button
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnZoomClick"
                        Style="{StaticResource ZoomButtonStyle}"
                        ToolTip="最大化" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  原窗口内容  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="48"
                        Background="Transparent"
                        BorderThickness="1.5"
                        CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#242836" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CodeFolderTextBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="#5B8CFF" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.18"
                                                    ShadowDepth="0"
                                                    Color="#5B8CFF" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  搜索图标  -->
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                FontSize="18"
                                Foreground="#9BA6C4"
                                Text="&#xe680;" />

                            <!--  输入框 + placeholder  -->
                            <Grid Grid.Column="1">
                                <TextBox
                                    x:Name="CodeFolderTextBox"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Foreground="#9BA6C4"
                                    Text="{Binding CodeFolder, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#9BA6C4"
                                    IsHitTestVisible="False"
                                    Text="选择源码文件夹，如：D:\Pengxh\Code\CodeGenerator\CodeGenerator">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CodeFolderTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="16,0"
                        Command="{Binding SelectCodeFolderCommand}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Text="&#xe680;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="选择文件夹" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding ChangeThemeCommand}"
                        Content="&#xe71f;"
                        FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                        FontSize="20"
                        Style="{StaticResource CompactButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="376" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <UniformGrid
                            Grid.Row="0"
                            Margin="16,0,0,16"
                            Columns="3"
                            Rows="1">
                            <Border
                                BorderBrush="#242836"
                                BorderThickness="1.5"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Margin="16"
                                        Background="#232E4C"
                                        CornerRadius="12">
                                        <TextBlock
                                            Margin="12"
                                            VerticalAlignment="Center"
                                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                            FontSize="20"
                                            Foreground="#5B8CFF"
                                            Text="&#xe652;" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <TextBlock Foreground="#9BA6C4" Text="已选源码文件" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding SelectedFiles.Count, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="4,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Foreground="#9BA6C4"
                                                Text="个" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Margin="16,0"
                                BorderBrush="#242836"
                                BorderThickness="1.5"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Margin="16"
                                        Background="#203A40"
                                        CornerRadius="12">
                                        <TextBlock
                                            Margin="12"
                                            VerticalAlignment="Center"
                                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                            FontSize="20"
                                            Foreground="#3FD9B4"
                                            Text="&#xe71a;" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <TextBlock Foreground="#9BA6C4" Text="有效代码" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding EffectiveCodeLines.Count, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="4,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Foreground="#9BA6C4"
                                                Text="行" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                BorderBrush="#242836"
                                BorderThickness="1.5"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Margin="16"
                                        Background="#26244E"
                                        CornerRadius="12">
                                        <TextBlock
                                            Margin="12"
                                            VerticalAlignment="Center"
                                            FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                            FontSize="20"
                                            Foreground="#9B6BFF"
                                            Text="&#xe6f0;" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <TextBlock Foreground="#9BA6C4" Text="预计生成" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding ExpectedCodePages, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="4,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Foreground="#9BA6C4"
                                                Text="页 · " />

                                            <TextBlock
                                                Margin="4,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Foreground="#9BA6C4"
                                                Text="{Binding DocFontSize, StringFormat={}{0}号字, FallbackValue=8号字}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Border
                            Grid.Row="1"
                            Margin="16,0,0,16"
                            BorderBrush="#242836"
                            BorderThickness="1.5"
                            CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1.5" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="源码文件" />

                                    <Border
                                        Grid.Column="1"
                                        Margin="16,0"
                                        Background="#232E4C"
                                        CornerRadius="12">
                                        <TextBlock
                                            Margin="12,4"
                                            FontSize="14"
                                            Foreground="#5B8CFF"
                                            Text="{Binding SelectedFiles.Count, StringFormat={}{0} 个, FallbackValue=0 个}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#9BA6C4"
                                        Text="双击打开 · 悬停移除" />
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    BorderBrush="#242836"
                                    BorderThickness="0,0,0,1.5" />

                                <ListBox
                                    Grid.Row="2"
                                    Margin="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding SelectedFiles}"
                                    ScrollViewer.CanContentScroll="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Margin="16,0,16,16"
                        BorderBrush="#242836"
                        BorderThickness="1.5"
                        CornerRadius="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Margin="16"
                                    Orientation="Horizontal">
                                    <Border
                                        Margin="0,2"
                                        BorderBrush="{StaticResource AccentGradientBrush}"
                                        BorderThickness="3"
                                        CornerRadius="1.5" />

                                    <TextBlock
                                        Margin="10,0,0,0"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="文档设置" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Foreground="#9BA6C4"
                                    Text="必填信息" />

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="16,16,16,8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="#FF5F57"
                                        Text="*" />

                                    <TextBlock
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Foreground="#9BA6C4"
                                        Text="页眉" />
                                </StackPanel>

                                <TextBox
                                    Grid.Row="3"
                                    Margin="16,0"
                                    Style="{StaticResource FieldTextBoxStyle}"
                                    Text="{Binding DocumentHeader}" />

                                <StackPanel
                                    Grid.Row="4"
                                    Margin="16,16,16,8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="#FF5F57"
                                        Text="*" />

                                    <TextBlock
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Foreground="#9BA6C4"
                                        Text="软件版本号" />
                                </StackPanel>

                                <TextBox
                                    Grid.Row="5"
                                    Margin="16,0"
                                    Style="{StaticResource FieldTextBoxStyle}"
                                    Text="{Binding SoftwareVersion, FallbackValue=V1.0.0}" />

                                <TextBlock
                                    Grid.Row="6"
                                    Margin="16"
                                    Foreground="#9BA6C4"
                                    Text="排版参数" />

                                <UniformGrid Grid.Row="7" Rows="1">
                                    <StackPanel Margin="16,0,8,0" Orientation="Vertical">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#9BA6C4"
                                            Text="代码页数" />

                                        <TextBox
                                            Margin="0,8,0,0"
                                            Style="{StaticResource FieldTextBoxStyle}"
                                            Text="{Binding DocumentPage, FallbackValue=60}" />
                                    </StackPanel>

                                    <StackPanel Margin="8,0,16,0" Orientation="Vertical">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#9BA6C4"
                                            Text="文档字号" />

                                        <TextBox
                                            Margin="0,8,0,0"
                                            Style="{StaticResource FieldTextBoxStyle}"
                                            Text="{Binding DocFontSize, FallbackValue=8}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock
                                    Grid.Row="8"
                                    Margin="16,16,16,8"
                                    Foreground="#9BA6C4"
                                    Text="源码文件后缀" />

                                <Grid Grid.Row="9" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}" />

                                    <Button
                                        Grid.Column="1"
                                        Height="40"
                                        Margin="16,0,0,0"
                                        Padding="12,0"
                                        Command="{Binding AddFileSuffixTypeCommand}"
                                        Content="&#xe605;"
                                        FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                        FontSize="16"
                                        Style="{StaticResource PrimaryCompactButtonStyle}" />
                                </Grid>

                                <ListBox
                                    Grid.Row="10"
                                    Margin="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding FileSuffixTypes}"
                                    ScrollViewer.CanContentScroll="False" />

                                <TextBlock
                                    Grid.Row="11"
                                    Margin="16,0"
                                    Foreground="#9BA6C4"
                                    Text="常用语言" />

                                <ListBox
                                    Grid.Row="12"
                                    Margin="16,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding DefaultFileSuffixTypes}"
                                    ScrollViewer.CanContentScroll="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Foreground" Value="#9BA6C4" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Setter Property="BorderBrush" Value="#242836" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border
                                                                        x:Name="CardBorder"
                                                                        Padding="14,10"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="18">
                                                                        <ContentPresenter />
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="Transparent" />
                                                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="#242836"
                BorderThickness="0,2,0,0">
                <Grid Margin="16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Foreground="#9BA6C4"
                                Text="{Binding CurrentFile, StringFormat={}正在读取：{0}, FallbackValue=正在读取：}" />

                            <TextBlock
                                Grid.Column="1"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#3FD9B4"
                                Text="{Binding CurrentProgress, FallbackValue=0%}" />
                        </Grid>

                        <ProgressBar
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="#242836"
                            BorderThickness="1.5"
                            Foreground="{StaticResource ProgressGradientBrush}"
                            Value="{Binding CurrentProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border
                                                        x:Name="PART_Track"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" />
                                                    <Border
                                                        x:Name="PART_Indicator"
                                                        Margin="2"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="4" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>

                    <Button
                        Grid.Column="1"
                        Margin="16,0"
                        Command="{Binding GeneratorCodeCommand}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                                    FontSize="16"
                                    Text="&#xe60c;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="生成文档" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding SaveDocumentCommand}"
                        Content="&#xe6ca;"
                        FontFamily="/CodeGenerator;component/IconFont/#iconfont"
                        FontSize="20"
                        Style="{StaticResource CompactButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>